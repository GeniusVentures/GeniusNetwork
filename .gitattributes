# Specify C++ for relevant file extensions
*.cpp linguist-language=C++
*.h linguist-language=C++
*.hpp linguist-language=C++
*.cxx linguist-language=C++
*.cc linguist-language=C++

# Shell scripts must stay LF: CRLF breaks the shebang line on Linux/macOS runners
*.sh text eol=lf

# Allow Markdown to be detected correctly
*.md linguist-language=Markdown
*.markdown linguist-language=Markdown
# Optionally, reset other files to their default detection
*.* linguist-language=
*.cap filter=lfs diff=lfs merge=lfs -text
